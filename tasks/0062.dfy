function statesFrom<S(==), A(==)>(step: (S, A) -> S, s: S, actions: seq<A>): seq<S>
  decreases |actions|
{
  if (|actions| == 0) then
    [s]
  else
    var rest := statesFrom(step, step(s, actions[0]), actions[1..]);
    ([s] + rest)
}

lemma statesFrom_ensures<S, A>(step: (S, A) -> S, s: S, actions: seq<A>)
  ensures (|statesFrom(step, s, actions)| == (|actions| + 1))
  ensures (statesFrom(step, s, actions)[0] == s)
  ensures forall i: int :: ((0 <= i) ==> (i < |actions|) ==> (statesFrom(step, s, actions)[(i + 1)] == step(statesFrom(step, s, actions)[i], actions[i])))
{
}

function validateFrom<S(==), A(==)>(step: (S, A) -> S, legal: (S, A) -> bool, s: S, befores: seq<S>, actions: seq<A>): bool
