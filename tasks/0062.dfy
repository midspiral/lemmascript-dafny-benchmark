function genuinePlayValidates<S(==), A(==)>(step: (S, A) -> S, legal: (S, A) -> bool, s: S, befores: seq<S>, actions: seq<A>): bool
  requires (|befores| == |actions|)
  requires ((|actions| > 0) ==> (befores[0] == s))
  requires forall i: int :: ((0 <= i) ==> ((i + 1) < |actions|) ==> (befores[(i + 1)] == step(befores[i], actions[i])))
  requires forall i: int :: ((0 <= i) ==> (i < |actions|) ==> legal(befores[i], actions[i]))
  decreases |actions|
{
  validateFrom(step, legal, s, befores, actions)
}

