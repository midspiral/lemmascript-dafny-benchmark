// Generated by lsc from index.ts

datatype Option<T> = None | Some(value: T)

method decodeAndValidatePath(rawPath: string) returns (res: Option<string>)
  ensures (match res { case Some(i_result_val) => ((i_result_val == Decoded(rawPath)) && !(HasPathTraversal(i_result_val))) case None => true })
{
  var filename: string := *;
  assume {:axiom} (filename == Decoded(rawPath));
  var hasBad: bool := *;
  assume {:axiom} (hasBad == HasPathTraversal(filename));
  if hasBad {
    return None;
  }
  return Some(filename);
}
